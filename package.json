{
  "name": "react-flexbox-z",
  "version": "5.0.0",
  "description": "Lightweight React flexbox utility components powered by rsx-z atomic CSS runtime.",
  "type": "module",
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.mjs",
      "require": "./build/index.cjs"
    }
  },
  "files": [
    "build"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf build dist",
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/delpikye-v/react-flexbox.git"
  },
  "homepage": "https://github.com/delpikye-v/react-flexbox#readme",
  "bugs": {
    "url": "https://github.com/delpikye-v/react-flexbox/issues"
  },
  "keywords": [
    "react",
    "react-flexbox",
    "flexbox",
    "flex",
    "layout",
    "ui",

    "atomic-css",
    "css-in-js",
    "runtime-css",

    "rsx-z",

    "responsive",
    "design-system",

    "typescript",

    "flex-container",
    "flex-item",

    "lightweight",

    "react-layout",
    "flex-utils",
    "flexbox-utilities"
  ],

  "author": "Delpi.Kye",

  "license": "MIT",

  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },

  "dependencies": {
    "csstype": "^3.1.3",
    "rsx-z": "^2.0.0"
  },

  "devDependencies": {
    "@rollup/plugin-commonjs": "^25",
    "@rollup/plugin-json": "^6",
    "@rollup/plugin-node-resolve": "^15",
    "@rollup/plugin-terser": "^0.4",
    "@types/node": "^25",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^6",
    "@typescript-eslint/parser": "^6",
    "eslint": "^8",
    "eslint-config-prettier": "^10",
    "eslint-plugin-import": "^2",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-simple-import-sort": "^13",
    "eslint-plugin-unused-imports": "^4",
    "prettier": "^3",
    "react": "^18",
    "react-dom": "^18",
    "rimraf": "^5",
    "rollup": "^4",
    "rollup-plugin-peer-deps-external": "^2",
    "rollup-plugin-typescript2": "^0.37",
    "tslib": "^2",
    "tsx": "^4",
    "typescript": "^5"
  }
}